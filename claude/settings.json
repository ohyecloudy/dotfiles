{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "VISUAL": "ec-wait",
    "EDITOR": "ec-wait"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git branch *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/org_roam/contact/**)",
      "Read(~/org_roam/daily/**)",
      "Read(~/org_roam/weekly/**)"
    ],
    "ask": [
      "Read(~/org_roam)",
      "Grep(~/org_roam)"
    ]
  },
  "language": "korean",
  "autoUpdatesChannel": "stable",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/.claude/hooks && python3 -X utf8 path_guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/.claude/hooks && python3 -X utf8 reply_style_guard.py"
          }
        ]
      }
    ]
  }
}
